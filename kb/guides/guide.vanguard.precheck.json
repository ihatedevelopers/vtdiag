          "action": "none"
        },
        {
          "textKey": "guide.vanguard.precheck.precheck_on.s2",
          "action": "none"
        },
        {
          "textKey": "guide.vanguard.precheck.precheck_on.s3",
          "action": "none"
        },
        {
          "textKey": "guide.vanguard.precheck.precheck_on.s4",
          "action": "none"
        },
        {
          "textKey": "guide.vanguard.precheck.precheck_on.s5",
          "action": "none"
        }
      ],
      "verify": []
    },
    {
      "id": "precheck_off",
      "when": [
        {
          "signal": "ask.vanguard_precheck_on",
          "is": "false"
        }
      ],
      "textKey": "guide.vanguard.precheck.precheck_off.text",
      "steps": [
        {
          "textKey": "guide.vanguard.precheck.precheck_off.s1",
          "action": "runFix",
          "target": "fix.vg.vgc_automatic"
        },
        {
          "textKey": "guide.vanguard.precheck.precheck_off.s2",
          "action": "none"
        },
        {
          "textKey": "guide.vanguard.precheck.precheck_off.s3",
          "action": "runCheck",
          "target": "vg.vgc_running"
        },
        {
          "textKey": "guide.vanguard.precheck.precheck_off.s4",
          "action": "none"
        }
      ],
      "verify": [
        {
          "signal": "vg.vgc_running",
          "is": "true"
        }
      ]
    },
    {
      "id": "not_sure",
      "when": [],
