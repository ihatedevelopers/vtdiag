{
  "id": "guide.hardware.freeze_checks",
  "titleKey": "guide.hardware.freeze_checks.title",
  "summaryKey": "guide.hardware.freeze_checks.summary",
  "bucket": "likelyHardware",
  "risk": "medium",
  "reboot": "recommended",
  "appliesTo": [
    "whole-pc-freeze-kernel-power-41",
    "usb-optical-drive-restart",
    "usb-selective-suspend-freeze"
  ],
  "preflight": [],
  "branches": [
    {
      "id": "optical",
      "when": [
        {
          "signal": "dev.usb_optical_drive",
          "is": "true"
        }
      ],
      "textKey": "guide.hardware.freeze_checks.optical.text",
      "steps": [
        {
          "textKey": "guide.hardware.freeze_checks.optical.s1",
          "action": "none"
        },
        {
          "textKey": "guide.hardware.freeze_checks.optical.s2",
          "action": "none"
        },
        {
          "textKey": "guide.hardware.freeze_checks.optical.s3",
          "action": "none"
        }
      ],
      "verify": [
        {
          "signal": "dev.usb_optical_drive",
          "is": "false"
        }
      ]
    },
    {
      "id": "whea",
      "when": [
        {
          "signal": "events.whea_errors",
          "is": "true"
        }
      ],
      "textKey": "guide.hardware.freeze_checks.whea.text",
      "steps": [
        {
          "textKey": "guide.hardware.freeze_checks.whea.s1",
          "action": "none"
        },
        {
          "textKey": "guide.hardware.freeze_checks.whea.s2",
          "action": "none"
        },
        {
          "textKey": "guide.hardware.freeze_checks.whea.s3",
          "action": "none"
        },
        {
          "textKey": "guide.hardware.freeze_checks.whea.s4",
          "action": "none"
        }
      ],
      "verify": []
    },
    {
      "id": "realtek",
      "when": [
        {
          "signal": "net.realtek25.active",
          "is": "true"
        },
        {
          "signal": "net.on_wifi",
          "is": "true"
        }
      ],
      "textKey": "guide.hardware.freeze_checks.realtek.text",
      "steps": [
        {
          "textKey": "guide.hardware.freeze_checks.realtek.s1",
          "action": "runFix",
          "target": "fix.net.disable_unused_adapter"
        }
      ],
      "verify": []
    },
    {
      "id": "temps",
