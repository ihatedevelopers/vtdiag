        },
        {
          "textKey": "guide.net.local_connection.router.s3",
          "action": "none"
        },
        {
          "textKey": "guide.net.local_connection.router.s4",
          "action": "none"
        },
        {
          "textKey": "guide.net.local_connection.router.s5",
          "action": "none"
        },
        {
          "textKey": "guide.net.local_connection.router.s6",
          "action": "none"
        }
      ],
      "verify": [
        {
          "signal": "net.gateway_loss",
          "is": "false"
        }
      ]
    },
    {
      "id": "general",
      "when": [],
