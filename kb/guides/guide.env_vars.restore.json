{
  "id": "guide.env_vars.restore",
  "titleKey": "guide.env_vars.restore.title",
  "summaryKey": "guide.env_vars.restore.summary",
  "bucket": "guidedManual",
  "risk": "medium",
  "reboot": "required",
  "appliesTo": [
    "missing-environment-variables"
  ],
  "preflight": [],
  "branches": [
    {
      "id": "broken",
      "when": [
        {
          "signal": "os.env_vars_broken",
          "is": "true"
        }
      ],
      "textKey": "guide.env_vars.restore.broken.text",
      "steps": [
        {
          "textKey": "guide.env_vars.restore.broken.s1",
          "action": "none"
        },
        {
          "textKey": "guide.env_vars.restore.broken.s2",
          "action": "none"
        },
        {
          "textKey": "guide.env_vars.restore.broken.s3",
          "action": "copyText",
          "target": "%SystemRoot%\\system32\\cmd.exe"
        },
        {
          "textKey": "guide.env_vars.restore.broken.s4",
          "action": "copyText",
          "target": "%SystemRoot%\\TEMP"
        },
        {
          "textKey": "guide.env_vars.restore.broken.s5",
          "action": "copyText",
          "target": "%USERPROFILE%\\AppData\\Local\\Temp"
        },
        {
          "textKey": "guide.env_vars.restore.broken.s6",
          "action": "copyText",
          "target": "%SystemRoot%\\system32;%SystemRoot%;%SystemRoot%\\System32\\Wbem;%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\"
        },
        {
          "textKey": "guide.env_vars.restore.broken.s7",
          "action": "none"
        },
        {
          "textKey": "guide.env_vars.restore.broken.s8",
          "action": "runCheck",
          "target": "os.env_vars_broken"
        }
      ],
      "verify": [
        {
          "signal": "os.env_vars_broken",
          "is": "false"
        }
      ]
    },
    {
      "id": "general",
      "when": [],
      "textKey": "guide.env_vars.restore.general.text",
      "steps": [
        {
          "textKey": "guide.env_vars.restore.general.s1",
          "action": "none"
        },
        {
          "textKey": "guide.env_vars.restore.general.s2",
          "action": "none"
        },
        {
          "textKey": "guide.env_vars.restore.general.s3",
          "action": "copyText",
          "target": "%SystemRoot%\\system32\\cmd.exe"
        },
        {
          "textKey": "guide.env_vars.restore.general.s4",
          "action": "copyText",
          "target": "%SystemRoot%\\TEMP"
        },
        {
          "textKey": "guide.env_vars.restore.general.s5",
          "action": "copyText",
          "target": "%USERPROFILE%\\AppData\\Local\\Temp"
        },
        {
          "textKey": "guide.env_vars.restore.general.s6",
          "action": "copyText",
          "target": "%SystemRoot%\\system32;%SystemRoot%;%SystemRoot%\\System32\\Wbem;%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\"
        },
        {
          "textKey": "guide.env_vars.restore.general.s7",
          "action": "none"
        },
        {
          "textKey": "guide.env_vars.restore.general.s8",
          "action": "runCheck",
          "target": "os.env_vars_broken"
        }
      ],
      "verify": [
        {
          "signal": "os.env_vars_broken",
          "is": "false"
        }
      ]
    }
  ],
  "outcomeAskKey": "guide.env_vars.restore.outcome"
}
