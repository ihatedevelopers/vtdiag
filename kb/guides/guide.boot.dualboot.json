      "probe": "sec.bitlocker_on",
      "must": "false",
      "severity": "warn",
      "failKey": "guide.boot.dualboot.pre.0"
    }
  ],
  "branches": [
    {
      "id": "dualboot",
      "when": [
        {
          "signal": "fw.dualboot",
          "is": "true"
        }
      ],
      "textKey": "guide.boot.dualboot.dualboot.text",
      "steps": [
        {
          "textKey": "guide.boot.dualboot.dualboot.s1",
          "action": "none"
        },
        {
          "textKey": "guide.boot.dualboot.dualboot.s2",
          "action": "restartToFirmware",
          "vendorTable": "bios_keys"
        },
        {
          "textKey": "guide.boot.dualboot.dualboot.s3",
          "action": "none"
        },
        {
          "textKey": "guide.boot.dualboot.dualboot.s4",
          "action": "none",
          "vendorTable": "bios_keys"
        },
        {
          "textKey": "guide.boot.dualboot.dualboot.s5",
          "action": "none"
        },
        {
          "textKey": "guide.boot.dualboot.dualboot.s6",
          "action": "none"
        },
        {
          "textKey": "guide.boot.dualboot.dualboot.s7",
          "action": "runCheck",
          "target": "sec.secureboot.on"
        },
        {
          "textKey": "guide.boot.dualboot.dualboot.s8",
          "action": "none"
        }
      ],
      "verify": [
        {
          "signal": "sec.secureboot.on",
          "is": "true"
        }
      ]
    },
    {
      "id": "general",
