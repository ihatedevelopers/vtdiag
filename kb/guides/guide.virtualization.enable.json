        {
          "textKey": "guide.virtualization.enable.check_first.s1",
          "action": "none"
        },
        {
          "textKey": "guide.virtualization.enable.check_first.s2",
          "action": "none"
        },
        {
          "textKey": "guide.virtualization.enable.check_first.s3",
          "action": "restartToFirmware",
          "vendorTable": "bios_keys"
        },
        {
          "textKey": "guide.virtualization.enable.check_first.s4",
          "action": "none",
          "vendorTable": "bios_keys"
        },
        {
          "textKey": "guide.virtualization.enable.check_first.s5",
          "action": "none"
        },
        {
          "textKey": "guide.virtualization.enable.check_first.s6",
          "action": "runCheck",
          "target": "sec.virtualization.enabled"
        }
      ],
      "verify": [
        {
          "signal": "sec.virtualization.enabled",
          "is": "true"
        }
      ]
    }
