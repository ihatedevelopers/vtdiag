{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vtdiag:schema:revocations:1",
  "title": "VTDiag KB revocation list",
  "description": "kb.revocations.json: signed, monotonic list of revoked KB versions and keys.",
  "type": "object",
  "properties": {
    "serial": {
      "type": "integer",
      "description": "Monotonic serial."
    },
    "issuedUtc": {
      "type": "string",
      "format": "date-time",
      "description": "Issued (UTC)."
    },
    "revokedVersions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Revoked KB versions."
    },
    "revokedKeyIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Revoked signing key ids."
    }
  },
  "required": [
    "serial",
    "issuedUtc"
  ],
  "additionalProperties": false
}
