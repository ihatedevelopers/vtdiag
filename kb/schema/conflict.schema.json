{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vtdiag:schema:conflict:1",
  "title": "VTDiag KB conflicting software",
  "description": "kb/conflicts/<kind>.json: known conflicting software with detection fingerprints, imported from research/conflicts.json.",
  "$defs": {
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable id (snake_case, as in conflicts.json), for example nahimic, realtek_2_5gbe."
        },
        "name": {
          "type": "string",
          "description": "Human name (English, not a string key: it is a product name)."
        },
        "kind": {
          "enum": [
            "antivirus",
            "vpn",
            "rgb_vendor",
            "overlay",
            "driver",
            "tweak_tool",
            "virtualization",
            "anticheat",
            "audio",
            "network_optimizer",
            "monitoring",
            "other"
          ],
          "description": "Kind."
        },
        "detect": {
          "type": "object",
          "properties": {
            "processNames": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Process image names."
            },
            "serviceNames": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Service names (not display names)."
            },
            "driverNames": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Kernel driver file names."
            },
            "moduleNames": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Module names seen as faulting modules in Riot crashes (for example ProductInfo.dll)."
            },
            "uninstallDisplayNameRegex": {
              "type": [
                "string",
                "null"
              ],
              "description": "Regex on uninstall DisplayName."
            },
            "networkAdapterRegex": {
              "type": [
                "string",
                "null"
              ],
              "description": "Regex on network adapter description."
            },
            "audioEndpointRegex": {
              "type": [
                "string",
                "null"
              ],
              "description": "Regex on audio endpoint name (prefer the locale-free HFP flag where possible)."
            },
            "registryKeys": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Registry values (HKLM\\…\\Key\\ValueName or keys); read through pack registry collectors generated by kb_builder."
            },
            "filePaths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "File or folder paths; read through pack file collectors generated by kb_builder."
            },
            "windowsFeatures": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Windows optional feature names."
            }
          },
          "additionalProperties": false,
          "description": "Detection fingerprints."
        },
        "effectKeys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "String keys of the observed effects."
        },
        "fix": {
          "type": "object",
          "properties": {
            "actionKey": {
              "type": "string",
              "description": "String key of the plain-language action."
            },
            "reversible": {
              "type": "boolean",
              "description": "The remedy is reversible."
            },
            "risk": {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "description": "Risk."
            },
            "fixIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "KB fix ids that implement it (often an entity-bound template such as fix.svc.disable_conflict_service)."
            },
            "guideIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Guide ids (uninstall flows are guides: the uninstaller runs unelevated in the player's context)."
            }
          },
          "required": [
            "actionKey",
            "reversible",
            "risk"
          ],
          "additionalProperties": false,
          "description": "Remedy."
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "description": "Confidence of the entry."
        },
        "category": {
          "enum": [
            "fps_performance",
            "vanguard",
            "crash_freeze_bsod",
            "tpm_secureboot_bios",
            "install_update_corrupt",
            "login_account_client",
            "network_ping",
            "gpu_driver",
            "audio_mic",
            "display_resolution",
            "input_mouse",
            "hardware_other",
            "other"
          ],
          "description": "Category used for the generated hypothesis prior."
        },
        "symptoms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Symptoms the generated hypothesis explains."
        },
        "wave": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "from": {
              "type": "string",
              "format": "date",
              "description": "First day."
            },
            "to": {
              "type": "string",
              "format": "date",
              "description": "Last day."
            },
            "boost": {
              "type": "number",
              "description": "Log-odds added while the analysis date is inside the window."
            }
          },
          "required": [
            "from",
            "to",
            "boost"
          ],
          "additionalProperties": false,
          "description": "Date-limited outbreak."
        },
        "evidence": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "redditMentions": {
              "type": "integer",
              "description": "Reddit mentions."
            },
            "solvedMentions": {
              "type": "integer",
              "description": "Mentions in solved threads."
            },
            "exampleThreadIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Example thread ids."
            },
            "webSources": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Web sources."
            }
          },
          "additionalProperties": false,
          "description": "Provenance."
        },
        "notesKey": {
          "type": [
            "string",
            "null"
          ],
          "description": "String key of maintainer notes."
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "detect",
        "fix",
        "confidence"
      ],
      "additionalProperties": false,
      "description": "A known conflicting software entry, imported mechanically from research/conflicts.json (113 entries) by tools/kb_builder.py. One generic provider materializes its signals for every entry (conflict.<id>.installed|running|service_present|driver_loaded|adapter_present|crash_module|audio_endpoint|feature_enabled|registry_present|file_present), and each entry yields a low-prior Generated hypothesis unless a full rule supersedes it. File: kb/conflicts/<kind>.json. Schema: kb/schema/conflict.schema.json."
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/item"
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  ]
}
