{
  "id": "fix.vg.quarantine_bootstatus",
  "titleKey": "fix.vg.quarantine_bootstatus.title",
  "explainKey": "fix.vg.quarantine_bootstatus.explain",
  "undoExplainKey": "fix.vg.quarantine_bootstatus.undo",
  "noticeKey": "fix.vg.quarantine_bootstatus.notice",
  "sideEffectKeys": [],
  "risk": "low",
  "reversibility": "exact",
  "admin": true,
  "reboot": "required",
  "scope": "persistent",
  "estMinutes": 1,
  "appliesTo": [
    "vgk-not-loaded-needs-reboot",
    "vanguard-install-loop",
    "vanguard-corrupt-install"
  ],
  "bind": {
    "file": {
      "kind": "file",
      "fromSignal": "vg.bootstatus_dat",
      "pick": "all"
    }
  },
  "guards": [],
  "steps": [
    {
      "op": "file.quarantine",
      "args": {
        "path": "$file.id"
      },
      "onFail": "abort"
    }
  ],
  "verify": [
    {
      "probe": "file.quarantine",
      "args": {
        "path": "$file.id"
      },
      "expect": {
        "exists": "false"
      },
      "when": "immediate"
    }
  ],
  "outcome": {
    "kind": "playtest",
    "askKey": "outcome.error_gone"
  },
  "successPrior": {
    "success": 1,
    "trials": 42
  },
  "minApp": "0.2.0",
  "tested": [
    "win11-25H2",
    "win10-22H2"
  ]
}
