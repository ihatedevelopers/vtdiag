{
  "id": "fix.net.disable_unused_adapter",
  "titleKey": "fix.net.disable_unused_adapter.title",
  "explainKey": "fix.net.disable_unused_adapter.explain",
  "undoExplainKey": "fix.net.disable_unused_adapter.undo",
  "noticeKey": "fix.net.disable_unused_adapter.notice",
  "sideEffectKeys": [],
  "risk": "low",
  "reversibility": "exact",
  "admin": true,
  "reboot": "none",
  "scope": "persistent",
  "estMinutes": 0.2,
  "appliesTo": [
    "realtek-2-5gbe-nic-stutter",
    "whole-pc-freeze-kernel-power-41",
    "usb-selective-suspend-freeze",
    "conflict-realtek_2_5gbe",
    "conflict-realtek_gbe_family"
  ],
  "bind": {
    "adapter": {
      "kind": "adapter",
      "fromSignal": "net.realtek25.unused",
      "pick": "one"
    }
  },
  "guards": [
    {
      "probe": "adapter.not_default_route",
      "args": {
        "instanceId": "$adapter.id"
      },
      "must": "true",
      "severity": "block",
      "failKey": "guard.adapter_is_active"
    },
    {
      "probe": "connectivity.other_adapter_online",
      "args": {
        "exceptInstanceId": "$adapter.id"
      },
      "must": "true",
      "severity": "block",
      "failKey": "guard.no_other_connection"
    }
  ],
  "steps": [
    {
      "op": "device.disable",
      "args": {
        "instanceId": "$adapter.id"
      },
      "onFail": "abort"
    }
  ],
  "verify": [
    {
      "probe": "device.disable",
      "args": {
        "instanceId": "$adapter.id"
      },
      "expect": {
        "enabled": "false"
      },
      "when": "immediate"
    }
  ],
  "deadman": {
    "seconds": 60,
    "check": "connectivity.internet"
  },
  "outcome": {
    "kind": "monitorCompare",
    "askKey": "outcome.stutter_gone",
    "monitorSignals": [
      "mon.frametime.periodic_spikes"
    ]
  },
  "drift": {
    "watch": true,
    "reasonKey": "drift.adapter_reenabled"
  },
  "successPrior": {
    "success": 48,
    "trials": 119
  },
  "minApp": "0.2.0",
  "tested": [
    "win11-25H2",
    "win10-22H2"
  ]
}
