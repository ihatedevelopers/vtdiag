{
  "id": "fix.generic.remove_compat_layer",
  "titleKey": "fix.generic.remove_compat_layer.title",
  "explainKey": "fix.generic.remove_compat_layer.explain",
  "undoExplainKey": "fix.generic.remove_compat_layer.undo",
  "sideEffectKeys": [],
  "risk": "low",
  "reversibility": "exact",
  "admin": true,
  "reboot": "none",
  "scope": "persistent",
  "estMinutes": 0.5,
  "appliesTo": [],
  "template": true,
  "bind": {
    "layer": {
      "kind": "compatLayer",
      "fromSignal": "riot.compat_layers_present",
      "pick": "one"
    }
  },
  "guards": [],
  "steps": [
    {
      "op": "appcompat.removeLayers",
      "args": {
        "exePath": "$layer.id",
        "hive": "HKCU",
        "layers": "$layer.name"
      },
      "onFail": "abort"
    }
  ],
  "verify": [
    {
      "probe": "appcompat.removeLayers",
      "args": {
        "exePath": "$layer.id",
        "hive": "HKCU",
        "layers": "$layer.name"
      },
      "expect": {
        "exists": "false"
      },
      "when": "immediate"
    }
  ],
  "outcome": {
    "kind": "playtest",
    "askKey": "outcome.past_loading_screen"
  },
  "successPrior": {
    "success": 1,
    "trials": 3
  },
  "minApp": "0.2.0",
  "tested": [
    "win11-25H2",
    "win10-22H2"
  ]
}
