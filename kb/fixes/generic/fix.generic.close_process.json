{
  "id": "fix.generic.close_process",
  "titleKey": "fix.generic.close_process.title",
  "explainKey": "fix.generic.close_process.explain",
  "undoExplainKey": "fix.generic.close_process.undo",
  "sideEffectKeys": [],
  "risk": "low",
  "reversibility": "sessionOnly",
  "admin": false,
  "reboot": "none",
  "scope": "session",
  "estMinutes": 0.2,
  "appliesTo": [],
  "template": true,
  "bind": {
    "proc": {
      "kind": "process",
      "fromSignal": "conflict.*.running",
      "pick": "all"
    }
  },
  "guards": [],
  "steps": [
    {
      "op": "process.closeGraceful",
      "args": {
        "imageName": "$proc.id"
      },
      "onFail": "continue"
    }
  ],
  "verify": [
    {
      "probe": "process.closeGraceful",
      "args": {
        "imageName": "$proc.id"
      },
      "expect": {
        "running": "false"
      },
      "when": "immediate"
    }
  ],
  "outcome": {
    "kind": "playtest",
    "askKey": "outcome.past_loading_screen"
  },
  "successPrior": {
    "success": 1,
    "trials": 3
  },
  "minApp": "0.2.0",
  "tested": [
    "win11-25H2",
    "win10-22H2"
  ]
}
