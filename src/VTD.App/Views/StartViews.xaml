<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:VTD.App.Controls"
                    xmlns:l="clr-namespace:VTD.App.Localization"
                    xmlns:vm="clr-namespace:VTD.App.ViewModels">

  <!-- 0 Welcome -->
  <DataTemplate DataType="{x:Type vm:WelcomeViewModel}">
    <StackPanel>
      <TextBlock Style="{StaticResource H1}" Text="{l:T Welcome.Title}" />
      <TextBlock Style="{StaticResource Lead}" Text="{l:T Welcome.Lead}" Margin="0,12,0,30" />
      <ItemsControl Focusable="False" Margin="0,0,0,30">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Path Data="M2,12 L9,19 L22,5" Stroke="{StaticResource GoodBrush}" StrokeThickness="2.4" Width="24" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          <StackPanel Grid.Column="1">
            <TextBlock Style="{StaticResource H3}" Text="{l:T Welcome.Promise1}" />
            <TextBlock Style="{StaticResource Muted}" Text="{l:T Welcome.Promise1.Detail}" Margin="0,3,0,0" />
          </StackPanel>
        </Grid>
        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Path Data="M7,4 L2,9 L7,14 M2,9 L15,9 C19,9 22,12 22,16 C22,19.5 19,22 15.5,22 L10,22" Stroke="{StaticResource InfoBrush}" StrokeThickness="2.2" Width="24" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          <StackPanel Grid.Column="1">
            <TextBlock Style="{StaticResource H3}" Text="{l:T Welcome.Promise2}" />
            <TextBlock Style="{StaticResource Muted}" Text="{l:T Welcome.Promise2.Detail}" Margin="0,3,0,0" />
          </StackPanel>
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Path Data="M12,2 L21,6 L21,12 C21,17 17,21 12,23 C7,21 3,17 3,12 L3,6 Z M8,12 L11,15 L16,9" Stroke="{StaticResource BoneBrush}" StrokeThickness="2" Width="24" Height="25" VerticalAlignment="Top" HorizontalAlignment="Left" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          <StackPanel Grid.Column="1">
            <TextBlock Style="{StaticResource H3}" Text="{l:T Welcome.Promise3}" />
            <TextBlock Style="{StaticResource Muted}" Text="{l:T Welcome.Promise3.Detail}" Margin="0,3,0,0" />
          </StackPanel>
        </Grid>
      </ItemsControl>
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource Primary}" Content="{l:T Welcome.Start}" Command="{Binding StartCommand}" MinWidth="150" />
        <Button Style="{StaticResource Ghost}" Content="{l:T Welcome.Privacy}" Command="{Binding PrivacyCommand}" Margin="12,0,0,0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,40,0,0">
        <TextBlock Style="{StaticResource Small}" Text="{l:T Welcome.HelperHint}" VerticalAlignment="Center" />
        <Button Style="{StaticResource Link}" Content="{l:T Welcome.HelperLink}" Command="{Binding Shell.GoHelperCommand}" Margin="6,0,0,0" FontSize="12" />
      </StackPanel>
    </StackPanel>
  </DataTemplate>

  <!-- 1 Intake -->
  <DataTemplate DataType="{x:Type vm:IntakeViewModel}">
    <StackPanel>
      <TextBlock Style="{StaticResource H2}" Text="{l:T Intake.Title}" />
      <TextBlock Style="{StaticResource Lead}" Text="{l:T Intake.Lead}" Margin="0,8,0,22" />
      <ItemsControl ItemsSource="{Binding Symptoms}" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ToggleButton Style="{StaticResource Chip}" Content="{Binding Text}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Intake.CodeLabel}" Margin="0,22,0,8" />
      <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left" MaxLength="40" AutomationProperties.Name="{l:T Intake.CodeLabel}" />
      <ItemsControl ItemsSource="{Binding Suggestions}" Focusable="False" Margin="0,8,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource Ghost}" Content="{Binding Text}" Command="{Binding DataContext.PickSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Id}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Style="{StaticResource Small}" Text="{Binding CodeHint}" Visibility="{Binding CodeHint, Converter={StaticResource Visible}}" Margin="0,6,0,0" />

      <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Intake.WhenLabel}" Margin="0,24,0,8" />
      <ItemsControl ItemsSource="{Binding When}" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ToggleButton Style="{StaticResource Chip}" Content="{Binding Text}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Padding="12,7" FontSize="13" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ItemsControl ItemsSource="{Binding Questions}" Focusable="False" Margin="0,14,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,10,0,0">
              <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding Text}" />
              <ItemsControl ItemsSource="{Binding Options}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ToggleButton Style="{StaticResource Chip}" Content="{Binding Text}" IsChecked="{Binding IsSelected, Mode=OneWay}" Padding="12,7" FontSize="13"
                                  Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}" CommandParameter="{Binding Id}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Button Style="{StaticResource Primary}" Content="{l:T Common.Next}" Command="{Binding NextCommand}" Margin="0,26,0,0" MinWidth="140" />
    </StackPanel>
  </DataTemplate>

  <!-- 2 Permission -->
  <DataTemplate DataType="{x:Type vm:PermissionViewModel}">
    <StackPanel>
      <TextBlock Style="{StaticResource H2}" Text="{l:T Permission.Title}" />
      <TextBlock Style="{StaticResource Lead}" Text="{l:T Permission.Lead}" Margin="0,10,0,20" />
      <c:ChamferBorder Style="{StaticResource Card}" Accent="{StaticResource InfoBrush}">
        <StackPanel>
          <TextBlock Style="{StaticResource H3}" Text="{l:T Permission.Prompt}" />
          <TextBlock Style="{StaticResource Muted}" Text="{l:T Permission.Why}" Margin="0,6,0,0" />
        </StackPanel>
      </c:ChamferBorder>
      <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
        <Button Style="{StaticResource Primary}" Content="{l:T Common.Continue}" Command="{Binding ContinueCommand}" MinWidth="150" />
        <Button Style="{StaticResource Ghost}" Content="{l:T Permission.Limited}" Command="{Binding LimitedCommand}" Margin="12,0,0,0" />
      </StackPanel>
      <TextBlock Style="{StaticResource Small}" Text="{l:T Permission.LimitedDetail}" Margin="0,14,0,0" />
    </StackPanel>
  </DataTemplate>

  <!-- 3 Scanning -->
  <DataTemplate DataType="{x:Type vm:ScanViewModel}">
    <StackPanel>
      <TextBlock Style="{StaticResource H2}" Text="{l:T Scan.Title}" />
      <TextBlock Style="{StaticResource Lead}" Text="{l:T Scan.Lead}" Margin="0,8,0,22" />
      <ProgressBar Style="{StaticResource ProgressLine}" Value="{Binding Percent, Mode=OneWay}" Maximum="100" Width="560" HorizontalAlignment="Left" />
      <TextBlock Style="{StaticResource Small}" Text="{Binding ProgressText}" Margin="0,8,0,20" />
      <ItemsControl ItemsSource="{Binding Areas}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <c:StatusGlyph Status="{Binding Status}" Visibility="{Binding IsFinished, Converter={StaticResource Visible}}" HorizontalAlignment="Left" />
              <Ellipse Width="9" Height="9" Fill="{StaticResource BoneBrush}" HorizontalAlignment="Left" Margin="4,0,0,0" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
                <Ellipse.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7" />
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Ellipse.Triggers>
              </Ellipse>
              <Ellipse Width="9" Height="9" Stroke="{StaticResource LineStrongBrush}" StrokeThickness="1.5" HorizontalAlignment="Left" Margin="4,0,0,0" Visibility="{Binding IsWaiting, Converter={StaticResource Visible}}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" Margin="12,1,0,0" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Style="{StaticResource Small}" Text="{l:T Scan.NeverHangs}" Margin="0,14,0,0" />
      <Button Style="{StaticResource Ghost}" Content="{l:T Scan.Cancel}" Command="{Binding CancelCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
