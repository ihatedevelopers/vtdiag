# VTDiag. Owner: Lead. The only .editorconfig in the repo (tests/VTD.Policy.Tests enforces this),
# so no folder can lower an analyzer severity.
root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,targets,csproj,xml,xaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Banned APIs (banned/BannedSymbols.*.txt) are errors.
dotnet_diagnostic.RS0030.severity = error
dotnet_diagnostic.RS0031.severity = error

# Culture safety (the Turkish dotted-I trap, decimal comma). Machine data is always invariant.
dotnet_diagnostic.CA1304.severity = error   # Specify CultureInfo
dotnet_diagnostic.CA1305.severity = error   # Specify IFormatProvider
dotnet_diagnostic.CA1309.severity = error   # Use ordinal StringComparison
dotnet_diagnostic.CA1310.severity = error   # Specify StringComparison for correctness
dotnet_diagnostic.CA1311.severity = error   # Specify a culture or use an invariant version

# Correctness rules worth failing on.
dotnet_diagnostic.CA2016.severity = error   # Forward the CancellationToken
dotnet_diagnostic.CA1416.severity = error   # Platform compatibility
dotnet_diagnostic.CA2200.severity = error   # Rethrow to preserve stack details
dotnet_diagnostic.CA1806.severity = error   # Do not ignore method results

csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_style_qualification_for_field = false:suggestion
