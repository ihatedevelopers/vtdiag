    <ProjectReference Include="..\..\src\VTD.Fixes\VTD.Fixes.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\..\src\VTD.Journal\VTD.Journal.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\..\src\VTD.Knowledge\VTD.Knowledge.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\..\src\VTD.Monitor\VTD.Monitor.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
