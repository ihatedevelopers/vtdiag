<Project>
  <!--
    VTDiag shared build settings. Owner: Lead. Agents never edit this file (request changes in your report).
    Layer selection (which BannedSymbols files apply) is computed in Directory.Build.targets from the project
    name, AFTER the project file is evaluated, so a project cannot opt itself out of its layer.
  -->
  <PropertyGroup>
    <VtdRepoRoot>$(MSBuildThisFileDirectory)</VtdRepoRoot>

    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PathMap Condition="'$(GITHUB_ACTIONS)' == 'true'">$(VtdRepoRoot)=/_/</PathMap>

    <!-- The UI needs real cultures (tr-TR) for display; machine data is invariant by rule, not by runtime switch. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>

    <Company>VTDiag project</Company>
    <Product>VTDiag</Product>
    <Copyright>VTDiag contributors. Not affiliated with Riot Games.</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <Version>0.0.1</Version>

    <!-- No packing, no obfuscation, no single-file compression (AV heuristics; DESIGN.md section 2). -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>
</Project>
