<Project>
  <!--
    Central package versions. Owner: Lead. Keep this list short and well-known; every addition is a
    Contracts-level decision (AV reputation, licence, supply chain). Request new packages in your report.
    Versions are pinned to releases at least two weeks old at the time they were added.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Transitive pinning lets us lift a vulnerable transitive dependency (see "Security pins") without a direct reference. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Security pins (transitive)">
    <!-- StreamJsonRpc 2.25.29 pulls MessagePack 2.5.302 (GHSA-qhrr-8q5h-9q3h, fixed in 2.5.303). NuGet audit fails the build otherwise. -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
  </ItemGroup>

  <ItemGroup Label="Analyzers (every project, wired in Directory.Build.targets)">
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Runtime">
    <!-- IPC App <-> Engine (and Engine <-> Monitor in M3). MIT. -->
    <PackageVersion Include="StreamJsonRpc" Version="2.25.29" />
    <!-- WMI reads (A1). Prefer bounded timeouts; a CIM/MI package can be requested if System.Management hangs. -->
    <PackageVersion Include="System.Management" Version="10.0.12" />
    <!-- SCM reads (A1) and writes (A3, Write layer only). -->
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
    <!-- EventLogReader / EventLogWatcher (A1, A5). -->
    <PackageVersion Include="System.Diagnostics.EventLog" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="UI (A6)">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- JSON Schema validation of fixtures and KB files in tests only. MIT. -->
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
  </ItemGroup>
</Project>
